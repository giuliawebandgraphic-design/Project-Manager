rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Projects collection
    match /projects/{projectId} {
      allow read, write: if isValidId(projectId);
    }

    // 2. Clients collection
    match /clients/{clientId} {
      allow read, write: if isValidId(clientId);
    }

    // 3. Quotes collection
    match /quotes/{quoteId} {
      allow read, write: if isValidId(quoteId);
    }

    // 4. Inventory collection
    match /inventory/{itemId} {
      allow read, write: if isValidId(itemId);
    }

    // 5. Price Catalog collection
    match /price_catalog/{itemId} {
      allow read, write: if isValidId(itemId);
    }

    // 6. Financial records collection
    match /financials/{recordId} {
      allow read, write: if isValidId(recordId);
    }

    // 7. Settings collection
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // 8. Real-time Studio Store document
    match /studio_store/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Fallback deny for unknown paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
