# ==============================================================================
# SAGE PAPER STUDIO MANAGER - ENVIRONMENT VARIABLES (VERCEL / PRODUCTION)
# ==============================================================================

# APP_URL: URL dove è ospitata l'applicazione (es. su Vercel https://tuo-studio.vercel.app)
# Utilizzata per la generazione dei link di condivisione del portale clienti e callback.
APP_URL="https://tuo-progetto.vercel.app"

# GEMINI_API_KEY: Opzionale. Chiave per funzionalità assistite da AI Studio / Gemini.
GEMINI_API_KEY=""

# VITE_SUPABASE_URL: Opzionale. URL del progetto Supabase se si desidera sincronizzazione Cloud remota.
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Opzionale. Chiave anon/pubblica di Supabase.
VITE_SUPABASE_ANON_KEY=""

# VITE_GOOGLE_CLIENT_ID: Opzionale. Client ID per l'integrazione Google Calendar con l'Atelier.
VITE_GOOGLE_CLIENT_ID=""
